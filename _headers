# TheHolding.ai - Cloudflare Workers Static Assets headers
# Updated: September 1, 2026

# Security headers apply to all public static responses.
# Do not set a global Cache-Control here: Cloudflare Workers Static Assets
# already defaults to max-age=0 + must-revalidate + ETag, which keeps HTML
# fresh without forcing full asset re-downloads.
/*
  # Security Headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

  # Content Security Policy
  # Added cloud.umami.is for analytics (script-src + connect-src)
  Content-Security-Policy: default-src 'self' https:; script-src 'self' 'unsafe-inline' https://api.coingecko.com https://cloud.umami.is https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.coingecko.com https://cloud.umami.is;

  # CORS
  Access-Control-Allow-Origin: https://theholding.ai
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type

# HTML and in-place CSS/JS must revalidate on every navigation/request.
# ETag keeps repeat visits efficient while preventing stale releases.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

# API responses must never be served from browser cache.
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

# Fingerprinted root assets may use long immutable browser caching.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Sitemap and robots may be cached briefly; they are not interactive UI.
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
