{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theholdingprotocol",
  "main": "worker/site-root.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Public static asset uploads are bounded further by the root .assetsignore file.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "exports": {
    "LearningIntake": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
