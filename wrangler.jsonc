{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theholdingprotocol",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LEARNING_INTAKE", "class_name": "LearningIntake" }
    ]
  },
  "exports": {
    "LearningIntake": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "LEARNING_INTAKE_ENABLED": "false",
    "LEARNING_CONTROLLER_NAME": "UNSET",
    "LEARNING_CONTROLLER_CONTACT": "UNSET",
    "LEARNING_LEGAL_BASIS_NOTICE": "UNSET"
  }
}
