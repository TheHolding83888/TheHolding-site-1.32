{
  "version": "1.0-root-routing-guard",
  "primaryHomepage": "https://theholding.ai/",
  "learningWorker": {
    "name": "theholding-learning-intake",
    "allowedRoute": "theholding.ai/api/*",
    "ownsStaticAssets": false,
    "mayOwnRoot": false,
    "mayOwnAgents": false,
    "mayOwnCompanies": false
  },
  "rootWranglerConfigAllowed": false,
  "deploymentCommand": "npx wrangler deploy -c worker/wrangler.learning.jsonc"
}
