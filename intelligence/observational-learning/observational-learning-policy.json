{
  "version": "0.2-observational-memory-prospective-evaluation-policy",
  "status": "production-candidate-read-only",
  "purpose": "Compile exact longitudinal Change Intelligence events into bounded observational memory, descriptive retrospective pattern candidates, and prospective support/counterevidence for an explicitly frozen baseline.",
  "authority": {
    "readOnly": true,
    "executionAuthority": "none",
    "capitalExecution": false,
    "walletAuthority": false,
    "policyMutationAuthority": false,
    "methodologyMutationAuthority": false,
    "repositoryMutationAuthorityFromLearning": false,
    "causalClaimAuthority": "none"
  },
  "namingBoundary": {
    "preferredCapabilityName": "Observational Memory + Prospective Pattern Evaluation",
    "legacyProjectName": "Autonomous Observational / World Learning v0.1",
    "learningClaim": "not-yet-earned",
    "reason": "Current episodes are exact structured observations and retrospective candidate associations. Learning is not claimed until frozen candidates are evaluated on later evidence under an explicit prospective contract."
  },
  "sourceContract": {
    "canonicalHistoryFile": "intelligence/change-history.json",
    "requiredHistoryVersion": "0.2.1-change-history",
    "requiredFieldsPerEvent": [
      "id",
      "detectedAt",
      "category",
      "entity",
      "metric",
      "previousValue",
      "currentValue",
      "sourceKeys"
    ],
    "exactByteBindingRequired": true,
    "appendOnlySourcePreferred": true,
    "samplingSemantics": "event-triggered-change-history-not-uniform-time-sampling",
    "absenceOfEventMeansNoChange": false,
    "patternFrequencyMayBeInterpretedAsMarketProbability": false,
    "patternScope": "recorded-change-events-only"
  },
  "prospectiveBaselineContract": {
    "file": "intelligence/observational-learning/observational-pattern-prospective-baseline.json",
    "requiredVersion": "0.1-observational-pattern-prospective-baseline",
    "requiredStatus": "frozen-prospective-baseline",
    "requiredInProduction": true,
    "baselineMayBeRewrittenFromLaterEvidence": false,
    "postFreezeEvidenceMustBeStrictlyLaterThanFrozenAt": true,
    "supportAndCounterevidenceMustBeSymmetric": true,
    "unscoredSignalsMayNotBecomeSupport": true,
    "prospectiveSupportMayBecomeLessonAutomatically": false,
    "prospectiveSupportMayBecomePredictionAutomatically": false,
    "prospectiveSupportMayBecomeCausalClaimAutomatically": false
  },
  "episodeClasses": [
    {
      "id": "productive-rate-change",
      "category": "productivity",
      "metrics": ["aprLatestPct"],
      "valueType": "numeric",
      "counterSemantics": "point-in-time-rate",
      "patternSignal": "direction",
      "semanticDomain": "protocol-economics"
    },
    {
      "id": "reported-income-progression",
      "category": "reporting",
      "metrics": ["currentMonthCashFlowUsd", "currentMonthGeneratedIncomeUsd"],
      "valueType": "numeric",
      "counterSemantics": "period-cumulative-counter",
      "patternSignal": "increment-velocity",
      "semanticDomain": "cash-flow-semantics"
    },
    {
      "id": "measurement-coverage-change",
      "category": "productivity",
      "metrics": ["coverage"],
      "valueType": "numeric",
      "counterSemantics": "point-in-time-ratio",
      "patternSignal": "direction",
      "semanticDomain": "measurement-quality"
    }
  ],
  "patternPolicy": {
    "minimumSupportEpisodes": 2,
    "minimumDirectionalConsistencyPct": 66.67,
    "status": "candidate-only",
    "causalClaim": false,
    "promotionAuthority": "none",
    "singleObservationCanBecomePattern": false,
    "candidateIsLesson": false,
    "candidateIsPolicy": false,
    "candidateIsPrediction": false,
    "candidateRepresentsRecordedChangeFrequencyOnly": true,
    "retrospectiveCandidateHasDecisionUseAuthority": false,
    "retrospectiveCandidateHasLearningStatus": false,
    "newRetrospectiveCandidatesAutomaticallyJoinFrozenBaseline": false
  },
  "prospectiveEvaluationPolicy": {
    "baselinePatternCount": 7,
    "baselineRole": "weak-first-cohort-for-falsifiable-prospective-evaluation",
    "supportDefinition": "later scored signal matches the frozen dominant signal",
    "counterevidenceDefinition": "later scored signal opposes the frozen dominant signal",
    "noSignalDefinition": "later eligible episode has null/unchanged/non-scored signal",
    "statusBeforeEvidence": "warming-no-post-freeze-scored-evidence",
    "statusAfterEvidence": "observing-prospectively",
    "marketProbabilityInference": false,
    "trendStrengthInference": false,
    "statisticalSignificanceClaim": false,
    "automaticExpiry": false,
    "automaticPromotion": false,
    "futurePromotionRequiresSeparateEarnedMethodology": true
  },
  "counterRules": {
    "negativeCumulativeDelta": "possible-period-reset-or-correction",
    "negativeCumulativeDeltaIsEconomicLoss": false,
    "monthlyCounterResetMayBeInferredAsCause": false,
    "incrementVelocityRequiresPriorNonResetIncrement": true
  },
  "epistemicRules": {
    "exactSourceEvent": "exact-observation",
    "numericDelta": "deterministic-derived-change",
    "sequenceOrder": "changed-after",
    "repeatedDirectionalPattern": "retrospective-candidate-association",
    "prospectiveSupport": "post-freeze-supporting-observation",
    "prospectiveCounterevidence": "post-freeze-counterevidence-observation",
    "correlationIsCausation": false,
    "temporalOrderIsCausation": false,
    "causalEdgeAllowed": false,
    "eventHistorySelectionBiasMustRemainExplicit": true
  },
  "realYieldOwnerContextBoundary": {
    "principle": "verified real-yield source + yield increase = positive owner economic signal",
    "marketFactAuthority": false,
    "yieldIncreaseAloneIsRiskFlag": false,
    "unknownYieldSourceHandling": "unknown-investigate-source",
    "observationalLearnerMayInferYieldCauseFromRateChangeAlone": false
  },
  "limits": {
    "maximumEpisodes": 5000,
    "maximumPatternCandidates": 500,
    "maximumPatternEvidenceIds": 50
  }
}
