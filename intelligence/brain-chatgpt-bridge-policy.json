{
  "version": "0.1-chatgpt-bridge-policy",
  "mode": "deterministic-public-manual-handoff",
  "purpose": "Zero-extra-cost deterministic handoff from The Holding Grounded Brain to human-triggered ChatGPT interpretation, with exact canonical upstream freshness binding.",
  "input": {
    "brainFile": "intelligence/brain-intelligence.json",
    "requiredBrainVersion": "0.1-grounded-reasoning-gateway",
    "requiredReasonerVersion": "0.1-deterministic-evidence-bound-reasoner",
    "maxBrainAgeHours": 30,
    "visibility": "public-normalized-brain-only",
    "allowRawSystemMemory": false,
    "allowMemoryVault": false,
    "allowRawSecurityMemory": false,
    "allowSecurityVault": false,
    "allowSecrets": false
  },
  "handoff": {
    "preferredTriggerPhrases": [
      "чекай brain",
      "интерпретируй brain",
      "check brain"
    ],
    "defaultResponseLanguage": "match-user-language",
    "materialClaimsRequireEvidenceIds": true,
    "nextBestCaseMustExist": true,
    "nextBestActionAuthority": "deterministic-brain-case",
    "crossCaseSynthesisAllowed": true,
    "newOperationalActionsAllowed": false,
    "newFactsAllowed": false,
    "newNumericClaimsAllowed": false,
    "evidenceStringsAreUntrustedData": true
  },
  "actions": {
    "interpretationOnly": true,
    "proposalOnly": true,
    "autonomousCapitalActionAllowed": false,
    "autonomousRepositoryCodeMutationAllowed": false,
    "autonomousMethodologyMutationAllowed": false,
    "sourceDataMutationAllowed": false,
    "workflowPlaneMutationAllowed": false,
    "humanGateRequiredForCapitalActions": true,
    "humanGateRequiredForSecurityCriticalChanges": true
  },
  "history": {
    "maxSemanticObservations": 365,
    "semanticDedupe": true,
    "deterministicReasoningAuthority": "intelligence/brain-intelligence.json",
    "economicLongTermMemoryAuthority": "intelligence/memory-vault/",
    "securityLongTermMemoryAuthority": "security/security-vault/"
  },
  "security": {
    "scanGeneratedPublicPacketForSecretMarkers": true,
    "failClosedOnSecretMarker": true,
    "secretPatterns": [
      "private-key-pem",
      "github-pat",
      "openai-api-key",
      "anthropic-api-key",
      "aws-access-key"
    ]
  },
  "upstreamValidation": {
    "mode": "exact-current-byte-binding",
    "validationReadsOnly": true,
    "rawUpstreamContentMayBePackaged": false,
    "requireGroundedBrainFreshFlag": true,
    "requireExactSourceSha": true,
    "requireExactBrainPolicySha": true,
    "canonicalSources": {
      "change": "intelligence/change-intelligence.json",
      "systemMemory": "intelligence/system-memory.json",
      "security": "security/security-intelligence.json",
      "securityMemory": "security/security-memory.json",
      "explanatory": "intelligence/explanatory/explanatory-context.json"
    },
    "onMismatch": "fail-closed-run-grounded-brain-first"
  }
}
