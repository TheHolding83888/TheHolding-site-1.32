{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theholding.ai/intelligence/proposals/proposal-schema.json",
  "title": "The Holding Proposal Work Queue",
  "type": "object",
  "required": [
    "version",
    "engineVersion",
    "generatedAt",
    "status",
    "source",
    "summary",
    "proposals",
    "constraints",
    "integrity"
  ],
  "properties": {
    "version": { "const": "0.1-proposal-work-queue" },
    "engineVersion": { "const": "0.1.1-deterministic-proposal-engine" },
    "generatedAt": { "type": "string" },
    "status": { "enum": ["ready", "watch", "blocked"] },
    "source": { "type": "object" },
    "summary": { "type": "object" },
    "proposals": { "type": "array" },
    "constraints": { "type": "object" },
    "integrity": {
      "type": "object",
      "required": ["queueHash"],
      "properties": { "queueHash": { "type": "string", "minLength": 64, "maxLength": 64 } }
    }
  },
  "additionalProperties": true
}
