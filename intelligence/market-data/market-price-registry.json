{
  "version": "0.1.1-market-price-registry-production-bootstrap",
  "purpose": "Canonical registry of externally priced market assets used by The Holding public capital surfaces. One external market-price observation is shared by every downstream consumer.",
  "bootstrap": {
    "firstProductionSnapshotRequired": true,
    "trigger": "tracked-main-push-after-workflow-install"
  },
  "semantics": {
    "oneExternalFetchPerRefresh": true,
    "unknownIsNotZero": true,
    "providerIdIsNotEconomicIdentity": true,
    "wrapperNavAndProtocolValuationStayUpstream": true,
    "executionAuthority": "none"
  },
  "provider": {
    "id": "coingecko",
    "endpoint": "https://api.coingecko.com/api/v3/simple/price",
    "currency": "usd",
    "credentialSource": "github-actions-secret-only"
  },
  "assets": [
    {"assetId":"bitcoin","providerId":"bitcoin","symbol":"BTC"},
    {"assetId":"ethereum","providerId":"ethereum","symbol":"ETH"},
