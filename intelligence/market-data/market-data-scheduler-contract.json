{
  "version": "0.2-market-data-scheduler-delivery-resilience",
  "status": "production",
  "workflow": "The Holding Market Data · Shared Refresh",
  "cron": "7,37 * * * *",
  "recoveryCron": "22,52 * * * *",
  "cadenceMinutes": 30,
  "schedulerAttemptCadenceMinutes": 15,
  "scheduledRefreshAdmissionAgeMinutes": 25,
  "timezone": "UTC",
  "purpose": "Single source of truth for resilient Shared Market Data wakes and the canonical Public Capital State refresh cadence used by fund TVL, company TVL and The Holding aggregate TVL.",
  "canonicalOutputs": [
    "intelligence/market-data/market-data.json",
    "intelligence/market-data/onchain-price-shadow.json",
    "intelligence/market-data/public-capital-state.json"
  ],
  "deliveryResilience": {
    "primaryThirtyMinuteHeartbeatPreserved": true,
    "sameWorkflowRecoverySchedule": true,
    "singleCanonicalWriter": true,
    "secondWriter": false,
    "externalWatchdogDispatch": false,
    "scheduledAttemptSkipsWhenSnapshotFresh": true,
    "nonScheduleEventsAlwaysAdmitted": true
  },
  "separationOfConcerns": {
    "dailyCoinGeckoBaselineIsSeparate": true,
    "sharedRefreshMayReuseDailyCoinGeckoWithoutExternalRequest": true,
    "onchainObservationRunsEveryAdmittedSharedRefresh": true,
    "publicCapitalStateRebuiltEveryAdmittedSharedRefresh": true
  },
  "epistemics": {
    "naturalScheduleProofRequired": true,
    "pushOrManualRunDoesNotProveSchedulerHealth": true,
    "schedulerAttemptDoesNotEqualMaterialization": true,
    "unknownIsNotZero": true,
    "partialIsNotTotal": true,
    "oneEconomicPositionOnce": true
  },
  "authority": {
    "repositoryMutationAuthority": true,
    "workflowDispatchAuthority": false,
    "capitalExecution": false,
    "walletAuthority": false,
    "methodologyMutationAuthority": false
  }
}
