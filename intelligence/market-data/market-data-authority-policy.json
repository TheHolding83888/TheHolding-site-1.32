{
  "version": "0.2-market-data-authority-btc-eth-pilot",
  "mode": "bounded-production-pilot",
  "defaultProductionAuthority": "coingecko-lane",
  "globalOnchainPromotionEnabled": true,
  "semantics": {
    "perAssetAuthorityRequired": true,
    "globalAllAssetSwitchForbidden": true,
    "coinGeckoRemainsFallbackAndSanityCheck": true,
    "canonicalCoinGeckoLaneRetainsItsExistingPreviousSnapshotFallback": true,
    "unknownIsNotZero": true,
    "productionWriterIntegrationEnabled": true,
    "automaticPolicyMutationAllowed": false,
    "automaticProductionMergeAllowed": false,
    "automaticCohortExpansionAllowed": false,
    "executionAuthority": "none"
  },
  "pilot": {
    "cohortId": "direct-chainlink-usd-ethereum-v0.1",
    "assetIds": ["bitcoin", "ethereum"],
    "maxPromotedAssetCount": 2,
    "requiredRouteType": "chainlink-v3",
    "requiredNetwork": "ethereum",
    "requiredQuote": "USD"
  },
  "onchainEligibility": {
    "requiredSnapshotMode": "shadow",
    "requiredObservationStatus": "shadow-ok",
    "maxShadowSnapshotAgeSeconds": 3600,
    "requireFinitePositiveUsd": true,
    "requireSnapshotProductionPriceAuthorityFalse": true,
    "requireObservationProductionPriceAuthorityFalse": true,
    "requireExecutionAuthorityNone": true
  },
  "fallbackOrderByRequestedPrimary": {
    "coingecko-lane": ["coingecko-lane", "unknown"],
    "onchain": ["onchain-shadow", "coingecko-lane", "unknown"]
  },
  "assetOverrides": {
    "bitcoin": {"requestedPrimary": "onchain"},
    "ethereum": {"requestedPrimary": "onchain"}
  }
}
