      "expectedMissingPrimitives": []
    },
    {
      "id": "holdout-embedded-vs-claimable-en",
      "prompt": "For company 009, separate what is compounding inside wrappers from what is claimable as rewards right now.",
      "expectedIntents": ["composite"],
      "requiredObjects": ["embedded-yield", "rewards"],
      "expectedEntityContains": ["009"],
      "expectedMissingPrimitives": []
    },
    {
      "id": "holdout-learning-proposal-ru",
      "prompt": "Что сейчас реально выучила система и какие предложения ждут решения?",
      "expectedIntents": ["composite"],
      "requiredObjects": ["learning-state", "proposal-state"],
      "expectedMissingPrimitives": []
    },
    {
      "id": "holdout-noisy-mixed-company-yield",
      "prompt": "monetra vs defitea pls – где щас выше yield и что materially поменялось recently?",
      "expectedIntents": ["composite"],
      "requiredObjects": ["productivity", "change-intelligence"],
      "expectedEntityContains": ["monetra", "defitea"],
