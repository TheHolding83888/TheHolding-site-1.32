      "expectedIntents": ["composite"],
      "requiredObjects": ["protocol-state", "productivity", "rewards"],
      "expectedEntityContains": ["Yield Basis"],
      "expectedMissingPrimitives": []
    },
    {
      "id": "holdout-pretracking-history-en",
      "prompt": "How much cash flow did Monetra generate before tracking began, and what is its current productivity?",
      "expectedIntents": ["unsupported-decomposed"],
      "requiredObjects": ["realised-cash-flow", "productivity"],
