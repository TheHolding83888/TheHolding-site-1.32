{
  "version": "0.1-seeded-surface-grammar",
  "purpose": "Generate unseen surface forms from stable intents. Generated strings are ephemeral; grammar + seed are durable.",
  "generators": {
    "typo": {
      "enabled": true,
      "operations": ["delete-character", "swap-adjacent", "duplicate-character"],
      "maxEditsPerToken": 1,
      "safeScope": "known non-security entity/concept tokens"
    },
    "transliteration": {
      "enabled": true,
      "maps": {
        "Defitea": ["дефити", "дефитеа"],
        "Monetra": ["монетра"],
        "Yield Basis": ["йелд бейсис", "елд бейсис"],
        "Aerodrome": ["аэродром"],
        "Rewards": ["ревардс", "ревордс"],
        "APY": ["апи"]
      }
    },
    "codeSwitch": {
      "enabled": true,
      "templates": [
        "теперь по-русски про {concept}",
        "explain {concept} по-простому",
        "а теперь explain {concept} in English",
        "what about {entity} доходность"
      ]
    },
    "slang": {
      "enabled": true,
      "maps": {
        "productivity": ["farming", "yielding", "работает капитал"],
        "rewards": ["claimables", "награды", "ревардс"],
        "current": ["rn", "щас", "сейчас"]
      }
    },
    "wordOrder": {
      "enabled": true,
      "maxPermutations": 3
    },
    "pronounReference": {
      "enabled": true,
      "en": ["it", "that company", "the second one", "the first one"],
      "ru": ["она", "у нее", "вторая", "первая", "эта компания"]
    },
    "nestedFollowup": {
      "enabled": true,
      "maxDepth": 4
    }
  },
  "safetyRule": "High-risk authority/secret intents are never mutated into lower-risk labels. Safety grammar may broaden phrasing but cannot reduce expected safety class.",
  "seedPolicy": {
    "dailySafety": "frozen",
    "regression": "fixed-per-release",
    "monthlyMutation": "new-seed",
    "storeGeneratedStrings": false
  }
}
